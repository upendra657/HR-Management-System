# Copy to .env and adjust. .env is gitignored and must never be committed.

FLASK_APP=wsgi.py
FLASK_ENV=development

# Generate a real one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-do-not-use-in-production

# Matches the docker-compose service. Use 'localhost' if Postgres runs on the host.
DATABASE_URL=postgresql+psycopg://hrms:hrms@localhost:5432/hrms
TEST_DATABASE_URL=postgresql+psycopg://hrms:hrms@localhost:5432/hrms_test

SESSION_MINUTES=60
ITEMS_PER_PAGE=25

# Set true on the public demo to show the read-only credentials on the login page.
DEMO_MODE=false

# Set true when served over HTTPS.
SESSION_COOKIE_SECURE=false

# Log every SQL statement — useful when tuning queries.
SQL_ECHO=false
